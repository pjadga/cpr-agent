# These need to be filled in by the user.
APP_KEY=     #ddev artisan key:generate

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# For Cloudflared Turnstile (captcha) Only relevant in mode=production
TURNSTILE_SITE_KEY=my-turnstile-site-key
TURNSTILE_SECRET_KEY=my-turnstile-secret-key

APP_NAME="Cyberpunk Companion App"
APP_ENV=local
APP_DEBUG=true

APP_URL="https://cyberpunk.ddev.site"
REVERB_DOMAIN="cyberpunk.ddev.site"
APP_DOMAIN="cyberpunk.ddev.site"
MODE="local"
NATIVEPHP_APP_WEBSITE="${APP_URL}"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

#Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#Database Connection
DB_CONNECTION="mariadb"
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

#Redis Connection
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

#Email
MAIL_MAILER="smtp"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT="1025"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Internal Host

# Reverb listens on loopback only. nginx forwards /app/ to it (see
# .ddev/nginx/reverb-app.conf), so the browser reaches the WebSocket on the
# site's own https origin -- exactly what a Herd install does.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085

# How Laravel itself publishes events to Reverb, server side, in-container.
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http

# No VITE_REVERB_* on purpose. The frontend derives host, port and scheme from
# window.location, which is correct once Reverb is same-origin. Setting them
# here would point the browser at an endpoint that no longer exists.

REVERB_MAX_REQUEST_SIZE=1000000
# App domain is here to allow hosted Agents and Foundries to authenticate each other
SANCTUM_STATEFUL_DOMAINS="${APP_DOMAIN},localhost,127.0.0.1"
