# ==========================================================================
# DDEV
#
# The template for running the Agent in DDEV containers (mariadb, redis, the
# ddev hostname). Copy to `.env`, then `ddev artisan key:generate`.
#
# The other two templates:
#   .env.example            Herd, `php artisan serve`, Tailscale, tunnels
#   .env.standalone.example the self-contained FrankenPHP build
#
# This environment is deliberately shaped like a real single-origin install:
# Reverb binds loopback inside the web container and nginx forwards /app/ to it
# (see .ddev/nginx/reverb-app.conf), so the browser reaches the WebSocket on
# the site's own https origin with no second port. `ddev agent-topology http|https`
# flips APP_URL to test both schemes.
# ==========================================================================

# These need to be filled in by the user.
APP_KEY=     #ddev artisan key:generate

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# Cloudflare Turnstile (captcha) on the auth forms. Captcha turns on only when
# BOTH are filled, so leaving them blank disables it. Do not put placeholder
# text here: any non-empty pair enables a captcha that cannot be solved.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

APP_NAME="Cyberpunk Companion App"
APP_ENV=local
APP_DEBUG=true

# DDEV serves the same site on both :80 and :443, so the scheme here is what
# decides whether the session cookie is Secure. Browse the scheme you set:
# loading https:// while this says http:// is itself the misconfiguration.
APP_URL="https://cyberpunk.ddev.site"
APP_DOMAIN="cyberpunk.ddev.site"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

#Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#Database Connection
DB_CONNECTION="mariadb"
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

#Redis Connection
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

#Email
MAIL_MAILER="smtp"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT="1025"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Reverb listens on loopback only. nginx forwards /app/ to it (see
# .ddev/nginx/reverb-app.conf), so the browser reaches the WebSocket on the
# site's own https origin -- exactly what a Herd install does. This is why
# .ddev/config.yaml no longer exposes a Reverb port: there is nothing to expose.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085

# How Laravel itself publishes events to Reverb, server side, in-container.
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=1000000

# No VITE_REVERB_* on purpose. The frontend derives host, port and scheme from
# window.location, which is correct once Reverb is same-origin. Setting them
# here would point the browser at an endpoint that no longer exists -- and the
# only symptom is a sheet that loads and then never updates.

# App domain is here to allow hosted Agents and Foundries to authenticate each other
SANCTUM_STATEFUL_DOMAINS="${APP_DOMAIN},localhost,127.0.0.1"

# Content Security Policy. Off by default; switch it on to exercise the policy
# locally the way the hosted instance runs it.
# CSP_ENABLED=true
