# Standalone / FrankenPHP environment TEMPLATE.
#
# Copy to `.env.standalone` and fill in the blanks, OR let `php artisan
# agent:install` generate the secrets for you (recommended). Laravel loads
# `.env.standalone` automatically when APP_ENV=standalone.
#
# NEVER commit a real .env.standalone — the working copy is gitignored on
# purpose. Every install must have its own APP_KEY and Reverb credentials.
#
# Zero external services: SQLite + file cache/sessions + database queue.

APP_NAME="Cyberpunk Companion App"
APP_ENV=standalone
# Generate with: php artisan key:generate --show   (agent:install does this)
APP_KEY=
APP_DEBUG=false
APP_URL="http://localhost:8000"
APP_DOMAIN="localhost:8000"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
# Absolute path. agent:install creates this file if missing.
DB_DATABASE=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=cpr-agent-standalone
# Unique per install — generate with: openssl rand -hex 16 (agent:install does this)
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Reverb server process (internal only — Caddy proxies /app/* to it).
# 8085 keeps clear of ddev's 8080 on a dev box; any free localhost port works.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085

# How Laravel reaches Reverb's HTTP events API (server-side, no proxy needed).
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=1000000

# No VITE_REVERB_* on purpose: the frontend derives host/port/scheme from
# window.location via the runtime-injected window.reverbConfig fallbacks, so
# one prebuilt asset bundle works on any host.

# Leave BOTH blank to disable the Cloudflare Turnstile captcha entirely (no
# external dependency). Fill BOTH in only if you want captcha on auth forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
