# Standalone / FrankenPHP prototype environment.
# Loaded when APP_ENV=standalone is set in the real environment
# (Laravel picks up .env.{APP_ENV} automatically).
#
# Zero external services: SQLite + file cache/sessions + database queue.

APP_NAME="Cyberpunk Companion App"
APP_ENV=standalone
APP_KEY=base64:jzZmiokX6ENbjioV2PJakzHyz/rKBIeR31UbQTa5Tc4=
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_DOMAIN="localhost:8000"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/home/chris/Dev/cyberpunk-red-agent/standalone/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=cpr-agent-standalone
REVERB_APP_KEY=b691383ace16cef6bd9857c1c762fa1b
REVERB_APP_SECRET=75264b1c5d447c9868527c88716ed0c8

# Reverb server process (internal only — Caddy proxies /app/* to it)
# 8085 because ddev already binds 8080 on this machine.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085

# How Laravel reaches Reverb's HTTP events API (server-side, no proxy needed)
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=1000000

# No VITE_REVERB_* on purpose: the frontend derives host/port/scheme from
# window.location via the runtime-injected window.reverbConfig fallbacks.

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
