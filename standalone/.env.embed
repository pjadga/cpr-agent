# Default env embedded in the standalone binary. Anything here can be
# overridden by real environment variables at launch ,  set at minimum:
#   APP_KEY, APP_URL, DB_DATABASE (absolute path), LARAVEL_STORAGE_PATH
APP_NAME="Cyberpunk Companion App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL="http://localhost:8000"
APP_DOMAIN="localhost:8000"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_DATABASE=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

CACHE_STORE=file
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=cpr-agent
REVERB_APP_KEY=
REVERB_APP_SECRET=

REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=1000000

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
