APP_NAME="Cyberpunk Companion App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Replace 192.168.1.X with your host PC's local IPv4 (via ipconfig)
# If using php artisan serve, keep :8000; if using Herd directly on Port 80, remove :8000
APP_URL=http://192.168.1.X:8000

# Reverb Credentials (prefilled placeholders needed for initial setup & key generation)
REVERB_APP_ID=cyberpunk-agent
REVERB_APP_KEY=cyberpunk-key
REVERB_APP_SECRET=cyberpunk-secret

# Database
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Session & Cache (File driver prevents SQLite table/locking collisions)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Sanctum Auth (Allows local host and LAN devices to authenticate without 419s)
SANCTUM_STATEFUL_DOMAINS=192.168.1.X:8000,192.168.1.X,cyberpunk-red-agent.test,localhost,127.0.0.1

# Reverb Server (0.0.0.0 binds to all network interfaces for LAN support)
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite Client Settings (Compiled into JS so players' devices connect to your PC's WebSockets)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=192.168.1.X
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http