# These need to be filled in by the user.
APP_KEY=     #ddev artisan key:generate

REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret

# For Cloudflared Turnstile (captcha) Only relevant in mode=production
TURNSTILE_SITE_KEY=my-turnstile-site-key
TURNSTILE_SECRET_KEY=my-turnstile-secret-key

APP_NAME="Cyberpunk Companion App"
APP_ENV=local
APP_DEBUG=true

APP_URL="https://your-tailscale-domain.ts.ne:10000" #Add in your full TS address here. The port is added if you are following the guide, so it may differ to yours.
REVERB_DOMAIN="your-tailscale-domain.ts.net" #CHANGE THIS IF USING TAILSCALE!!! NO PORT. If hosting, this would be the APP_URL sans tls. EG mylocal.tailscale-words.ts.net
APP_DOMAIN="your-tailscale-domain.ts.net" #CHANGE THIS IF USING TAILSCALE!!! INCLUDE THE PORT. Follows same rule as REVERB_DOMAIN EG mylocal.tailscale-words.ts.net:10000


MODE="local"
NATIVEPHP_APP_WEBSITE="${APP_URL}"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

#Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#Database Connection
DB_CONNECTION="mariadb"
DB_HOST="db"
DB_PORT="3306"
DB_DATABASE="db"
DB_USERNAME="db"
DB_PASSWORD="db"

#Redis Connection
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=redis
# CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

#Email
MAIL_MAILER="smtp"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT="1025"
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Internal Host

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Host can be left as 'web' if using DDEV. If this is being hosted online (not shared), it will need to match REVERB_DOMAIN
REVERB_HOST="web" #or ddev domain
#This is the internal port, it can be left as 8080. If you hit TLS errors or CORS, try 8081.
REVERB_PORT=8080
REVERB_SCHEME=http

#External
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_DOMAIN}"
#8081 for normal, 8443 for TailScale if following the guide.
VITE_REVERB_PORT=8443
VITE_REVERB_SCHEME="https"

REVERB_MAX_REQUEST_SIZE=1000000
# App domain is here to allow hosted Agents and Foundries to authenticate each other
SANCTUM_STATEFUL_DOMAINS="${APP_DOMAIN},localhost,127.0.0.1"
