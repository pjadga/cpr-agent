# ==========================================================================
# HERD / PLAIN LOCAL INSTALL
#
# This is the template for running the Agent under Laravel Herd, or under a
# bare `php artisan serve`. It is also the right starting point for putting the
# Agent behind Tailscale, Cloudflare Tunnel or any other proxy: those change
# only APP_URL, not anything else in this file.
#
# Copy to `.env` and fill in the blanks, or run `php artisan agent:install`,
# which creates the file from this template and generates the secrets for you.
#
# The other two templates:
#   .env.ddev               DDEV containers (mariadb, redis, ddev hostnames)
#   .env.standalone.example the self-contained FrankenPHP build
#
# Defaults here are the zero dependency ones: SQLite, and file based cache,
# sessions and queue. A fresh clone runs without setting up MySQL or Redis.
# ==========================================================================

APP_NAME="Cyberpunk Companion App"
APP_ENV=local
# Generate with: php artisan key:generate   (agent:install does this)
APP_KEY=
APP_DEBUG=true

# ---------------------------------------------------------------------------
# The address players type. This one line decides almost everything about
# how the Agent behaves, so it is worth getting right:
#
#   * the session cookie is marked Secure only when this starts https://
#     (see SESSION_SECURE_COOKIE below)
#   * the browser derives the WebSocket host, port and scheme from it
#   * the Foundry setup code hands it to the Bridge verbatim, and the Bridge
#     derives its own WebSocket endpoint from it
#
# localhost only works for a browser on this machine. Players on phones need
# an address their device can reach, so use whichever of these you are on:
#
#   http://192.168.1.50:8000       LAN IP, `php artisan serve` (find it with
#                                  `ip addr` on Linux, `ipconfig` on Windows)
#   http://cpr-agent.test          Herd, plain http
#   https://cpr-agent.test         Herd, after `herd secure`
#   https://your-box.ts.net        Tailscale Serve or a tunnel
#
# Include the port whenever it is not 80 or 443.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:8000"
APP_DOMAIN="localhost:8000"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite by default. agent:install creates the file if it is missing.
# On Windows use forward slashes: dotenv reads "\c" in a double quoted value as
# an invalid escape sequence and refuses to load the file.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave this commented out and it follows APP_URL: Secure cookies on https,
# plain on http. Uncomment as false only if you serve the app over http on a
# hostname or LAN IP -- browsers silently discard Secure cookies there, and
# every login will bounce straight back to the login page.
# (An empty value here reads as false, not "unset", so comment rather than blank.)
# SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=cpr-agent-local
# Unique per install. agent:install generates these.
REVERB_APP_KEY=
REVERB_APP_SECRET=

# The Reverb process itself. Loopback only: it is reached through /app on the
# app's own address, not on a port of its own. Any free local port works.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8085

# How Laravel reaches Reverb's HTTP events API, server side.
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SCHEME=http
REVERB_MAX_REQUEST_SIZE=1000000

# No VITE_REVERB_* on purpose. The frontend derives host, port and scheme from
# window.location, so one asset build works on any host, and the Foundry Bridge
# needs no Reverb settings at all. Setting any of them points the browser at an
# endpoint that has to genuinely exist -- a leftover VITE_REVERB_SCHEME=https on
# a plain-http install is the classic "everything loads but nothing updates".
# Set them only if you are serving Reverb from somewhere other than the page
# origin, and then set all of them.

VITE_APP_NAME="${APP_NAME}"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Devices that may hold a session cookie. Add the LAN address players use if it
# differs from APP_DOMAIN, or they get a 419 on every form.
SANCTUM_STATEFUL_DOMAINS="${APP_DOMAIN},localhost,127.0.0.1"

# Content Security Policy. Off by default: it is only worth switching on where
# the Agent is exposed to more than your own LAN. When on, the policy allows
# images from the signed-in user's own configured Foundry.
# CSP_ENABLED=true

# Leave BOTH blank to disable the Cloudflare Turnstile captcha. Fill BOTH in
# only if you want captcha on the auth forms.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Interpreter subcommand agent:serve injects when it re-invokes artisan.
# Leave blank under a normal PHP binary. Set to php-cli under FrankenPHP.
AGENT_PHP_ARGS=
